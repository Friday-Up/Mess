# ============================================================
# Git忽略规则 - Mess项目
# ============================================================
# 规则优先级: 后定义的规则优先级更高
# 取反规则: 以!开头表示不忽略（即使前面规则匹配也保留）
# 通配符: * 匹配任意字符，** 匹配任意层级目录
# ============================================================

# --------------------------------------------------------
# Maven构建输出
# --------------------------------------------------------
# target/目录包含编译后的class文件、JAR包、测试报告等
# 这些是构建产物，不应提交到版本控制
# !.mvn/wrapper/ 保留Maven Wrapper JAR（确保没有Maven也能构建）
# !**/src/main/**/target/ 和 !**/src/test/**/target/ 是多余的取反
# （因为target/已在根目录忽略，子目录也会被忽略）
# --------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# --------------------------------------------------------
# IntelliJ IDEA项目配置
# --------------------------------------------------------
# .idea/ 目录: 项目配置（编码、库、模块等）
# *.iws: IntelliJ工作区文件（窗口布局、运行配置等）
# *.iml: IntelliJ模块文件（模块依赖、源码路径等）
# *.ipr: IntelliJ项目文件（项目级配置）
# 这些文件包含本地环境信息，不同开发者配置不同
# --------------------------------------------------------
.idea/
*.iws
*.iml
*.ipr

# --------------------------------------------------------
# VS Code工作区配置
# --------------------------------------------------------
# .vscode/目录: 包含launch.json、settings.json等
# 如果团队统一VS Code配置，可考虑提交.vscode/settings.json
# --------------------------------------------------------
.vscode/

# --------------------------------------------------------
# macOS系统文件
# --------------------------------------------------------
# .DS_Store: macOS Finder自动生成的目录元数据文件
# 存储目录图标位置、视图选项等，无项目意义
# --------------------------------------------------------
.DS_Store

# --------------------------------------------------------
# Spring Boot帮助文件
# --------------------------------------------------------
# HELP.md: Spring Initializr自动生成的参考文档
# 包含常用命令和链接，首次阅读后可忽略
# --------------------------------------------------------
HELP.md

# --------------------------------------------------------
# 其他建议添加的忽略规则（按需启用）
# --------------------------------------------------------
# 日志文件
# logs/
# *.log
#
# 操作系统临时文件
# Thumbs.db        # Windows缩略图缓存
# ehthumbs.db      # Windows媒体缓存
# Desktop.ini      # Windows文件夹设置
#
# Java相关
# *.class          # 编译后的class文件
# *.jar            # JAR包（除非是lib目录下的依赖）
# *.war            # WAR包
#
# 敏感配置文件（包含密码、密钥等）
# application-local.yml  # 本地开发配置
# .env                   # 环境变量文件
# keystore.p12           # SSL证书
#