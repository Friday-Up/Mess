# ============================================================
# Git 忽略文件配置
# 
# 指定Git版本控制应忽略的文件和目录。
# 这些文件通常是构建产物、IDE配置或系统文件，不应纳入版本控制。
# 
# 忽略规则:
# - target/: Maven构建输出目录
# - .idea/: IntelliJ IDEA项目配置
# - .vscode/: VS Code工作区配置
# - .DS_Store: macOS系统文件
# - HELP.md: Spring Boot自动生成的帮助文件
# 
# 作者: zhangyaolong.5
# 创建时间: 2026-05-26
# ============================================================

# -----------------------------------------------------------
# Maven 构建输出
# target/ 目录包含编译后的类文件、JAR包等构建产物
# 这些文件可以通过 mvn clean 重新生成，不应纳入版本控制
# !.mvn/wrapper/maven-wrapper.jar 例外：Maven Wrapper需要纳入版本控制
# -----------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# -----------------------------------------------------------
# IntelliJ IDEA 项目配置
# .idea/ 目录包含IDE的项目设置、运行配置等
# *.iws: IntelliJ工作区文件（个人设置）
# *.iml: IntelliJ模块文件（可由IDE自动生成）
# *.ipr: IntelliJ项目文件（可由IDE自动生成）
# 这些文件因开发者而异，不应纳入版本控制
# -----------------------------------------------------------
.idea/
*.iws
*.iml
*.ipr

# -----------------------------------------------------------
# VS Code 工作区配置
# .vscode/ 目录包含VS Code的设置和扩展推荐
# 团队共享配置可选择性纳入版本控制
# -----------------------------------------------------------
.vscode/

# -----------------------------------------------------------
# macOS 系统文件
# .DS_Store: macOS自动生成的目录元数据文件
# 存储文件夹的自定义属性（如图标位置）
# 不应纳入版本控制
# -----------------------------------------------------------
.DS_Store

# -----------------------------------------------------------
# Spring Boot 帮助文件
# HELP.md: Spring Boot Initializr自动生成的帮助文档
# 包含常用命令和链接，可随时重新生成
# -----------------------------------------------------------
HELP.md