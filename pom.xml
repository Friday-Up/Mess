<?xml version="1.0" encoding="UTF-8"?>
<!-- Mess项目Maven构建配置: Spring Boot 3.2.5, Web+JPA+Security+Cache+Redis+Actuator, H2, SpringDoc, Lombok -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Maven POM模型版本 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父POM: Spring Boot Starter Parent, 继承默认配置(依赖版本/插件/编译选项) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <!-- 不从本地仓库查找父POM，直接从Maven中央仓库下载 -->
        <relativePath/>
    </parent>

    <!-- 项目坐标: groupId=组织标识, artifactId=项目名称, version=版本(SNAPSHOT=开发版) -->
    <groupId>com.example</groupId>
    <artifactId>mess</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mess</name>
    <description>A simple Spring Boot demo project</description>

    <!-- 项目属性 -->
    <properties>
        <!-- Java版本: 需要JDK 17+（Spring Boot 3.x最低要求） -->
        <java.version>17</java.version>
    </properties>

    <!-- 项目依赖: 每个starter提供一组相关的自动配置和依赖 -->
    <dependencies>
        <!-- Spring Boot Web Starter
             提供Spring MVC、内嵌Tomcat、Jackson等
             用于构建RESTful Web应用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        
        <!-- Spring Data JPA Starter
             提供Hibernate ORM、Spring Data JPA
             用于数据库访问和ORM映射 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <!-- Spring Security Starter
             提供认证和授权功能
             默认启用表单登录和Basic认证 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        
        <!-- Spring Validation Starter
             提供JSR-303 Bean Validation支持
             用于请求参数校验（@Valid, @NotBlank等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        
        <!-- Spring Data Redis Starter
             提供Redis客户端（Lettuce）和Spring Data Redis
             用于分布式缓存和会话存储 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        
        <!-- Spring Cache Starter
             提供缓存抽象和注解支持
             @Cacheable, @CacheEvict, @CachePut等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        
        <!-- Spring Boot Actuator Starter
             提供生产级监控端点
             健康检查、指标监控、环境信息等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        
        <!-- H2 数据库
             嵌入式内存数据库，开发测试使用
             scope=runtime: 只在运行时需要 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        
        <!-- SpringDoc OpenAPI Starter
             生成OpenAPI 3.0文档和Swagger UI
             访问地址: http://localhost:8080/swagger-ui.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>
        
        <!-- Lombok
             编译时代码生成工具，简化POJO编写
             @Getter, @Setter, @Builder等
             scope=provided: 编译时可用，不打包到最终JAR -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Boot Test Starter
             提供JUnit 5、Mockito、Spring Test等
             scope=test: 只在测试时可用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- Spring Security Test
             提供安全测试工具
             @WithMockUser, WebTestClient等 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        
    </dependencies>

    <!-- 构建配置 -->
    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin
                 打包为可执行JAR，包含所有依赖
                 支持mvn spring-boot:run运行项目 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>